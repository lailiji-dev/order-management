[Unit]
Description=Peiliao daily SQLite backup
[Service]
Type=oneshot
User=peiliao
Group=peiliao
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/www/server/peiliao-app/data /www/server/peiliao-app/backups
UMask=0077
MemoryMax=256M
ExecStart=/usr/bin/python3 /www/server/peiliao-app/backup.py /www/server/peiliao-app/data/peiliao.sqlite3 /www/server/peiliao-app/backups
