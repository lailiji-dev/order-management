[Unit]
Description=Peiliao shared orders API
After=network.target
[Service]
Type=simple
User=peiliao
Group=peiliao
WorkingDirectory=/www/server/peiliao-app
ExecStart=/usr/bin/python3 /www/server/peiliao-app/app.py --data /www/server/peiliao-app/data/peiliao.sqlite3
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/www/server/peiliao-app/data /www/server/peiliao-app/backups
UMask=0077
LimitNOFILE=4096
TasksMax=64
MemoryMax=256M
[Install]
WantedBy=multi-user.target
